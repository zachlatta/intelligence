#!/usr/bin/env bash
# Run a command with TEST_DATABASE_URL pointing at a throwaway Postgres 18 in Docker, removed after.
#   scripts/with-test-postgres go test -race ./...
set -euo pipefail
if [ "${INTELLIGENCE_TEST_CAPACITY_HELD:-}" != 1 ]; then
  exec scripts/with-test-capacity "$0" "$@"
fi
name="intelligence-test-pg-$$"
# The cluster is discarded after the run. Keep its data on tmpfs to avoid competing
# for disk I/O with other suites while Postgres retains its normal commit settings.
# Logins still use SCRAM-SHA-256 with real passwords, but with one hash iteration instead of
# 4096: every test pool connection otherwise spends most of its setup in PBKDF2 under -race.
# initdb needs the setting too, for the superuser's password.
docker run -d --rm --name "$name" --tmpfs /var/lib/postgresql \
  -e POSTGRES_PASSWORD=test -e POSTGRES_INITDB_ARGS="-c scram_iterations=1" \
  -p 127.0.0.1::5432 postgres:18-alpine -c max_connections=500 -c scram_iterations=1 >/dev/null
trap 'docker stop "$name" >/dev/null 2>&1 || true' EXIT
for _ in $(seq 1 60); do
  docker exec "$name" pg_isready -U postgres -h 127.0.0.1 >/dev/null 2>&1 && break
  sleep 0.5
done
docker exec "$name" pg_isready -U postgres -h 127.0.0.1 >/dev/null
port=$(docker port "$name" 5432/tcp | head -1 | sed 's/.*://')
export TEST_DATABASE_URL="postgres://postgres:test@127.0.0.1:${port}/postgres?sslmode=disable"
"$@"
