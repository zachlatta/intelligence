#!/usr/bin/env bash
# Install the host client on this machine, as a systemd user service. After that it keeps itself
# on the server's version (self-update), so this is needed once per host.
# Run from a checkout of this repo, as the user whose Paseo daemon it reports:
#
#   deploy/install-host
#
# The first run writes ~/.config/intelligence/host.env (mode 600) from HOST_SERVER in the
# environment; later runs keep that file and only rebuild and restart. A host with no key yet joins
# an account: this prints its code, to enter on the server's account page.
set -euo pipefail

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
env_file="$HOME/.config/intelligence/host.env"
unit_dir="$HOME/.config/systemd/user"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# a host installed before dev boxes were called hosts: take over its env file, key and unit
old_dir="$HOME/.config/intelligence"
if [ -f "$old_dir/devbox.env" ] && [ ! -f "$env_file" ]; then
  (umask 077; sed 's/^DEVBOX_/HOST_/' "$old_dir/devbox.env" > "$env_file") && rm "$old_dir/devbox.env"
  echo "moved $old_dir/devbox.env to $env_file"
fi
if [ -f "$old_dir/devbox.key" ] && [ ! -f "$old_dir/host.key" ]; then
  mv "$old_dir/devbox.key" "$old_dir/host.key"
fi
if [ -f "$unit_dir/intelligence-devbox.service" ]; then
  systemctl --user disable --now intelligence-devbox.service >/dev/null 2>&1 || true
  rm -rf "$unit_dir/intelligence-devbox.service" "$unit_dir/intelligence-devbox.service.d"
fi

if [ ! -f "$env_file" ]; then
  : "${HOST_SERVER:?set HOST_SERVER (the base URL of the server) for the first install}"
  mkdir -p "$(dirname "$env_file")"
  (umask 077; printf 'HOST_SERVER=%s\n' "$HOST_SERVER" > "$env_file")
  echo "wrote $env_file"
fi

rev=$(git -C "$repo" rev-parse HEAD)
mkdir -p "$HOME/.local/bin" "$unit_dir"
(cd "$repo" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.buildCommit=$rev" \
  -o "$HOME/.local/bin/intelligence.new" ./cmd/intelligence)
mv "$HOME/.local/bin/intelligence.new" "$HOME/.local/bin/intelligence"
install -m 644 "$repo/deploy/intelligence-host.service" "$unit_dir/intelligence-host.service"
# earlier installs set the version in a drop-in; the binary carries it now
rm -f "$unit_dir/intelligence-host.service.d/version.conf"
rmdir "$unit_dir/intelligence-host.service.d" 2>/dev/null || true

systemctl --user daemon-reload
systemctl --user enable intelligence-host.service >/dev/null
systemctl --user restart intelligence-host.service
systemctl --user --no-pager status intelligence-host.service | head -5

key_file="$HOME/.config/intelligence/host.key"
if [ ! -s "$key_file" ]; then
  echo "waiting for the host's code..."
  for _ in $(seq 1 30); do
    line=$(journalctl --user -u intelligence-host.service --since "-2min" --no-pager -o cat 2>/dev/null | grep "enter the code" | tail -1 || true)
    if [ -n "$line" ]; then echo "$line"; break; fi
    sleep 1
  done
  [ -n "${line:-}" ] || echo "no code yet: journalctl --user -u intelligence-host | grep 'enter the code'"
fi
