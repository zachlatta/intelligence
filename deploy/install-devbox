#!/usr/bin/env bash
# Install the dev box client on this machine, as a systemd user service. After that it keeps itself
# on the server's version (self-update), so this is needed once per box.
# Run from a checkout of this repo, as the user whose Paseo daemon it reports:
#
#   deploy/install-devbox
#
# The first run writes ~/.config/intelligence/devbox.env (mode 600) from DEVBOX_SERVER in the
# environment; later runs keep that file and only rebuild and restart. A box with no key yet joins
# an account: this prints its code, to enter on the server's account page.
set -euo pipefail

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
env_file="$HOME/.config/intelligence/devbox.env"
unit_dir="$HOME/.config/systemd/user"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ ! -f "$env_file" ]; then
  : "${DEVBOX_SERVER:?set DEVBOX_SERVER (the base URL of the server) for the first install}"
  mkdir -p "$(dirname "$env_file")"
  (umask 077; printf 'DEVBOX_SERVER=%s\n' "$DEVBOX_SERVER" > "$env_file")
  echo "wrote $env_file"
fi

rev=$(git -C "$repo" rev-parse HEAD)
mkdir -p "$HOME/.local/bin" "$unit_dir"
(cd "$repo" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.buildCommit=$rev" \
  -o "$HOME/.local/bin/intelligence.new" ./cmd/intelligence)
mv "$HOME/.local/bin/intelligence.new" "$HOME/.local/bin/intelligence"
install -m 644 "$repo/deploy/intelligence-devbox.service" "$unit_dir/intelligence-devbox.service"
# earlier installs set the version in a drop-in; the binary carries it now
rm -f "$unit_dir/intelligence-devbox.service.d/version.conf"
rmdir "$unit_dir/intelligence-devbox.service.d" 2>/dev/null || true

systemctl --user daemon-reload
systemctl --user enable intelligence-devbox.service >/dev/null
systemctl --user restart intelligence-devbox.service
systemctl --user --no-pager status intelligence-devbox.service | head -5

key_file="$HOME/.config/intelligence/devbox.key"
if [ ! -s "$key_file" ]; then
  echo "waiting for the box's code..."
  for _ in $(seq 1 30); do
    line=$(journalctl --user -u intelligence-devbox.service --since "-2min" --no-pager -o cat 2>/dev/null | grep "enter the code" | tail -1 || true)
    if [ -n "$line" ]; then echo "$line"; break; fi
    sleep 1
  done
  [ -n "${line:-}" ] || echo "no code yet: journalctl --user -u intelligence-devbox | grep 'enter the code'"
fi
