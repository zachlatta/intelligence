[Unit]
Description=Intelligence dev box client: reports this box's Paseo daemon to the server
After=network-online.target
Wants=network-online.target

[Service]
# DEVBOX_SERVER (and optional DEVBOX_KEY_FILE, DEVBOX_NAME, DEVBOX_INTERVAL, DEVBOX_PASEO_HOME, DEVBOX_AUTOUPDATE)
EnvironmentFile=%h/.config/intelligence/devbox.env
ExecStart=%h/.local/bin/intelligence devbox
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
